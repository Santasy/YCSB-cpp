{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${PYTHONPATH}:${fileDirname}:${workspaceFolder}/tools/:${workspaceFolder}/tools/BenchGrid/"
            },
            "args": [
                "--dry-run",
                // "--skip-run",
                // "--ds",
                // "std",
                "--workloads",
                "workloada",
                "workloadb",
                "workloadc",
                "workloadd",
                "workloade",
                "workloadf"
            ]
        },
        {
            "name": "Debug YCSB - Legacy Workload A (null, Load)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-load",
                "-db",
                "wtree",
                "-P",
                "workloads/workload_kv_ingest",
                "-s",
                "-p",
                "resultformat=csv",
                "-p",
                "output.file=${workspaceFolder}/storage/out_load.log",
            ],
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "text": "set sysroot /",
                    "ignoreFailures": true,
                },
            ]
        },
        {
            "name": "Debug YCSB - Legacy Workload A (null, Run)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-run",
                "-db",
                "wtree",
                "-P",
                "workloads/workload_kv_ingest",
                "-s",
                "-p",
                "resultformat=csv",
                "-p",
                "output.file=${workspaceFolder}/storage/out_run.log",
            ],
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "text": "set sysroot /",
                    "ignoreFailures": true,
                },
            ]
        },
        {
            "name": "Load + Run",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-run",
                "-load",
                "-db",
                "wtree",
                "-P",
                "workloads/workload_kv_ingest",
                "-s",
                "-p",
                "resultformat=csv",
                "-p",
                "output.file=${workspaceFolder}/storage/out_loadrun.log",
            ],
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "text": "set sysroot /",
                    "ignoreFailures": true,
                },
            ]
        },
        {
            "name": "Debug YCSB - LMDB Workload KV Session",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-run",
                "-db",
                "lmdb",
                "-P",
                "adapters/lmdb/lmdb.properties",
                "-P",
                "./workloads/workload_kv_rmw",
                "-s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug YCSB - Leaves -acid",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-run",
                "-db",
                "leaves",
                "-P",
                "adapters/leaves/leaves.properties",
                "-P",
                "./workloads/workload_kv_concurrent_write"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch C++ exceptions",
                    "text": "catch throw",
                    "ignoreFailures": false
                },
                {
                    "description": "Break on std::bad_weak_ptr",
                    "text": "catch throw std::bad_weak_ptr",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug YCSB - Catch Exceptions (Leaves Workload A RUN)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-load",
                "-db",
                "leaves",
                "-P",
                "adapters/leaves/leaves.properties",
                "-P",
                "./workloads/workload_kv_concurrent_session",
                "-s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch C++ exceptions",
                    "text": "catch throw",
                    "ignoreFailures": false
                },
                {
                    "description": "Break on std::bad_weak_ptr",
                    "text": "catch throw std::bad_weak_ptr",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": ""
        },
        {
            "name": "Debug YCSB - Release Build (Leaves Load)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-db",
                "leaves",
                "-P",
                "adapters/leaves/leaves.properties",
                "-P",
                "workloads/workloada",
                "-load",
                "-s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch C++ exceptions",
                    "text": "catch throw",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug YCSB - Release Build (Leaves Run)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb",
            "args": [
                "-db",
                "leaves",
                "-P",
                "adapters/leaves/leaves.properties",
                "-P",
                "workloads/workloada",
                "-run",
                "-s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch C++ exceptions",
                    "text": "catch throw",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${input:buildFolder}/ycsb_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Streamlit analysis",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "tools/plot_all_workloads.py"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "debugpy: run_all_workloads",
            "type": "debugpy",
            "request": "launch",
            "module": "tools.run_all_workloads",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${PYTHONPATH}:${fileDirname}:${workspaceFolder}/tools/:${workspaceFolder}/tools/BenchGrid/"
            },
            "args": [
                "--dry-run",
                // "--skip-run",
                // "--ds",
                // "std",
                "--workloads",
                "workloada",
                "workloadb",
                "workloadc",
                "workloadd",
                "workloade",
                "workloadf"
            ]
        },
        {
            "name": "debugpy questions",
            "type": "debugpy",
            "request": "launch",
            "module": "tools.ycsb_bench.questions",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${PYTHONPATH}:${fileDirname}:${workspaceFolder}/tools/:${workspaceFolder}/tools/BenchGrid/"
            },
            "args": []
        },
    ],
    "inputs": [
        {
            "id": "buildFolder",
            "type": "pickString",
            "description": "Build folder containing the binary to debug (release = build, debug+DBs = build-dbg-db, debug no-DB = build-debug, tests = build-test, data-structs debug = build-dbg-ds)",
            "options": [
                "build",
                "build-test",
                "build-dbg-db",
                "build-dbg-ds",
                "build-debug",
            ],
            "default": "build-dbg-ds"
        }
    ]
}